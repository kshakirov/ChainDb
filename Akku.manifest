#!r6rs ; -*- mode: scheme; coding: utf-8 -*-
(import (akku format manifest))

(akku-package ("chaindb" "0.1.0-alpha.1")
  (synopsis "A continuation-driven in-memory database for Chez Scheme")
  (description
   "ChainDb is an experimental single-threaded runtime and in-memory database."
   "It combines cooperative continuations, a dispatcher, non-blocking FIFO input, byte-native command decoding, and bytevector-backed storage.")
  (authors "kshakirov")
  (license "MIT")
)
